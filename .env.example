# Prefer: npm run setup  (auto-generates AUTH_SECRET + migrates DB)
# Or copy this file to .env and replace AUTH_SECRET yourself.

DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Optional — leave blank for demo-only testing
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
OPENAI_API_KEY=""

# true until you want live Google + OpenAI
DEMO_MODE="true"
